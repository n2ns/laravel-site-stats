{
    "name": "n2ns/laravel-site-stats",
    "description": "N2N Stats: cookieless web analytics for Laravel, for a single site or many. Only daily aggregates are stored.",
    "keywords": ["laravel", "analytics", "privacy", "cookieless", "statistics", "web-analytics"],
    "homepage": "https://n2ns.com/projects/laravel-site-stats",
    "license": "Apache-2.0",
    "authors": [{"name": "Datafrog LLC", "homepage": "https://datafrog.io"}],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "filament/filament": "^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "filament/filament": "Statistics page, Sites resource and widgets for Filament panels (^5.0)"
    },
    "autoload": {
        "psr-4": {
            "N2ns\\Stats\\": "src/",
            "N2ns\\Stats\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {"N2ns\\Stats\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {"providers": ["N2ns\\Stats\\StatsServiceProvider"]}
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"pestphp/pest-plugin": true}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
